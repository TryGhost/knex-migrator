{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "local>TryGhost/renovate-config"
  ],
  "packageRules": [
    {
      "description": "Use caret ranges for published dependencies so they dedupe with consumers like Ghost.",
      "matchDepTypes": [
        "dependencies",
        "optionalDependencies"
      ],
      "rangeStrategy": "bump"
    },
    {
      "description": "Supported knex peer majors are widened by hand once CI covers them.",
      "matchDepTypes": [
        "peerDependencies"
      ],
      "matchPackageNames": [
        "knex"
      ],
      "enabled": false
    },
    {
      "description": "Keep the knex 2 test alias on the lowest supported knex 2 version (Ghost's current version).",
      "matchDepNames": [
        "knex2"
      ],
      "allowedVersions": "2.4.2"
    },
    {
      "description": "Keep CI runtime jobs pinned to Node 22.13.1; .nvmrc may still move independently.",
      "matchManagers": [
        "github-actions"
      ],
      "matchDepTypes": [
        "uses-with"
      ],
      "matchDepNames": [
        "node"
      ],
      "matchPackageNames": [
        "actions/node-versions"
      ],
      "matchCurrentValue": "22.13.1",
      "allowedVersions": "22.13.1"
    },
    {
      "description": "Keep the next-runtime CI lane pinned to Node 24.14.1 until we intentionally move it.",
      "matchManagers": [
        "github-actions"
      ],
      "matchDepTypes": [
        "uses-with"
      ],
      "matchDepNames": [
        "node"
      ],
      "matchPackageNames": [
        "actions/node-versions"
      ],
      "matchCurrentValue": "24.14.1",
      "allowedVersions": "24.14.1"
    }
  ]
}
