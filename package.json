{
  "name": "knex-migrator",
  "version": "6.4.1",
  "packageManager": "pnpm@12.18.0",
  "description": "Database migrations with knex.",
  "keywords": [
    "ghost",
    "migration",
    "knex",
    "knex-migrations",
    "knex migration",
    "knex migrations",
    "bookshelf migration",
    "bookshelf"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TryGhost/knex-migrator.git"
  },
  "bugs": {
    "url": "https://github.com/TryGhost/knex-migrator/issues"
  },
  "homepage": "https://github.com/TryGhost/knex-migrator#readme",
  "author": {
    "name": "Ghost Foundation",
    "email": "hello@ghost.org",
    "web": "https://ghost.org"
  },
  "main": "lib",
  "types": "lib/index.d.ts",
  "license": "MIT",
  "scripts": {
    "lint": "oxlint --quiet && oxfmt --check . && pnpm lint:types",
    "lint:fix": "oxlint --fix && oxfmt .",
    "lint:types": "tsc -p test/types",
    "format": "oxfmt .",
    "test": "LEVEL=fatal vitest run",
    "test:unit": "pnpm lint && LEVEL=fatal vitest run test/unit",
    "smoke:ghost": "node scripts/ghost-consumer-smoke.js",
    "posttest": "pnpm lint",
    "coverage": "LEVEL=fatal vitest run --coverage",
    "preship": "pnpm test",
    "ship": "pro-ship"
  },
  "bin": {
    "knex-migrator": "./bin/knex-migrator",
    "knex-migrator-init": "./bin/knex-migrator-init",
    "knex-migrator-health": "./bin/knex-migrator-health",
    "knex-migrator-migrate": "./bin/knex-migrator-migrate",
    "knex-migrator-reset": "./bin/knex-migrator-reset",
    "knex-migrator-rollback": "./bin/knex-migrator-rollback"
  },
  "engines": {
    "node": "^22.18.0 || ^24.14.1"
  },
  "dependencies": {
    "@tryghost/database-info": "^2.3.22",
    "@tryghost/errors": "^3.4.8",
    "@tryghost/logging": "^5.4.8",
    "commander": "^15.1.0",
    "debug": "^4.4.3",
    "mysql2": "^3.24.6",
    "semver": "^7.8.6"
  },
  "files": [
    "bin",
    "lib",
    "migrations",
    "loggingrc.js"
  ],
  "peerDependencies": {
    "knex": "^2.4.2 || ^3.0.0"
  },
  "devDependencies": {
    "@tryghost/pro-ship": "1.1.9",
    "@types/node": "26.6.6",
    "@vitest/coverage-v8": "5.1.0",
    "knex": "3.3.0",
    "knex2": "npm:knex@2.4.2",
    "nconf": "0.13.0",
    "oxfmt": "0.76.0",
    "oxlint": "1.91.0",
    "rimraf": "6.1.4",
    "sinon": "22.1.0",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  },
  "optionalDependencies": {
    "better-sqlite3": "^13.0.3"
  }
}
